# Copy to .env. Never commit .env.
#
# Phase 1 needs none of these: the compliance core has no external dependencies.
# They are listed now so the shape of the system is visible from the start.

# --- Paths -------------------------------------------------------------------
KILL_SWITCH_PATH=./data/kill-switch.json
COMPLIANCE_AUDIT_PATH=./data/compliance-audit.jsonl

# --- Anthropic (phases 2+) ---------------------------------------------------
# Only `npm run caller:smoke` needs this today (and the live voice server in
# phase 5). The whole test suite, including the thirty Phase 4 acceptance
# scenarios, runs against scripted models with no key and no network. Which
# model runs where is config/models.yaml, not here.
#
# Entry points (npm run ...) read this file at the repo root. A variable that is
# already exported wins over the file. In a cloud session, set it as an
# environment variable in the environment settings instead of a file: the
# container is ephemeral and the file would not survive it.
ANTHROPIC_API_KEY=
# Cloud sessions do not pass ANTHROPIC_API_KEY through (it is reserved for their
# own auth). Set this name in the environment settings instead; it is used when
# ANTHROPIC_API_KEY is empty.
LEXI_ANTHROPIC_API_KEY=

# --- The account desk (npm run serve) ----------------------------------------
# This page edits the list of people the system will call, so the server refuses
# to start without a token. Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=
PORT=8080

# --- Apollo.io (phase 3) -----------------------------------------------------
# See docs/APOLLO-SETUP.md. Start on the free plan and run `npm run apollo:check`
# before paying for anything.
APOLLO_API_KEY=
# Public HTTPS host Apollo can reach. Phone enrichment is asynchronous and will
# not work without one. Office direct dials do not need it.
PUBLIC_BASE_URL=
# Shared secret Apollo's phone-delivery webhook must present (it is put in the
# webhook_url we give Apollo). Required for phone enrichment, which is off by
# default (enrichment.phone.enabled in config/campaign.yaml). Generate one with:
#   openssl rand -hex 24
APOLLO_WEBHOOK_SECRET=
# What one Apollo credit costs you, in dollars. Used to hold spend to a ceiling,
# so err high. Default 0.05; config/campaign.yaml carries the same figure.
APOLLO_USD_PER_CREDIT=
# Only if Apollo renames People Search. Default /mixed_people/search; the newer
# name for the same call is /mixed_people/api_search.
APOLLO_SEARCH_PATH=
# Scout's User-Agent when it reads a page. Add a contact address if you like.
SCOUT_USER_AGENT=

# --- Voice provider (phase 5) ------------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
# The shared secret the provider sends to our custom LLM endpoint at
# POST /v1/chat/completions. That endpoint must be publicly reachable for the
# provider to call it, so it is never served without this. Generate one with:
#   openssl rand -hex 24
VOICE_SHARED_SECRET=
# Printed by `npm run voice:assistant`.
VAPI_ASSISTANT_ID=
# Vapi's id for each imported Twilio number (Phone Numbers in the Vapi dashboard).
VAPI_PHONE_NUMBER_ID_AU=
VAPI_PHONE_NUMBER_ID_NZ=
# Keeps an encrypted copy of each recording (AES-256-GCM). 64 hex characters:
#   openssl rand -hex 32
# Back it up: without it an archived recording cannot be read.
RECORDING_ENCRYPTION_KEY=
# Port for `npm run voice:serve` (the account desk uses PORT).
VOICE_PORT=8081

# --- Twilio (phases 5-6) -----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The caller line identification numbers. These must be real and answerable for
# at least 30 days after any call. Put them in config/policy.yaml as well; the
# compliance gate refuses to dial until they are set there.
TWILIO_NUMBER_AU=
TWILIO_NUMBER_NZ=

# --- Transactional email, system mail to Vinay only (phase 6) ----------------
SMTP_URL=
MEETING_REQUEST_TO=

# --- Infrastructure (phase 2+) -----------------------------------------------
# A relative file: URL is resolved against the repository root, not the working
# directory, so the CLI and the running system always open the same database.
DATABASE_URL=file:./data/anzsdr.db
# Setting this switches the enrichment queue from in-memory to BullMQ on Redis
# (jobs then survive a restart; run `npm run enrich:worker`). Leave it unset to
# use the in-memory queue, which needs nothing.
# REDIS_URL=redis://localhost:6379
