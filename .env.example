# Copy to .env. Never commit .env.
#
# Phase 1 needs none of these: the compliance core has no external dependencies.
# They are listed now so the shape of the system is visible from the start.

# --- Paths -------------------------------------------------------------------
KILL_SWITCH_PATH=./data/kill-switch.json
COMPLIANCE_AUDIT_PATH=./data/compliance-audit.jsonl

# --- Anthropic (phases 2+) ---------------------------------------------------
# Only `npm run caller:smoke` needs this. The whole test suite, including the
# thirty Phase 4 acceptance scenarios, runs against scripted models with no key
# and no network. Which model runs where is config/models.yaml, not here.
ANTHROPIC_API_KEY=

# --- The account desk (npm run serve) ----------------------------------------
# This page edits the list of people the system will call, so the server refuses
# to start without a token. Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=
PORT=8080

# --- Apollo.io (phase 3) -----------------------------------------------------
# See docs/APOLLO-SETUP.md. Start on the free plan and run `npm run apollo:check`
# before paying for anything.
APOLLO_API_KEY=
# Public HTTPS host Apollo can reach. Phone enrichment is asynchronous and will
# not work without one. Office direct dials do not need it.
PUBLIC_BASE_URL=

# --- Voice provider (phase 5) ------------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
# The shared secret the provider sends to our custom LLM endpoint at
# POST /v1/chat/completions. That endpoint must be publicly reachable for the
# provider to call it, so it is never served without this. Generate one with:
#   openssl rand -hex 24
VOICE_SHARED_SECRET=

# --- Twilio (phases 5-6) -----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The caller line identification numbers. These must be real and answerable for
# at least 30 days after any call. Put them in config/policy.yaml as well; the
# compliance gate refuses to dial until they are set there.
TWILIO_NUMBER_AU=
TWILIO_NUMBER_NZ=

# --- Transactional email, system mail to Vinay only (phase 6) ----------------
SMTP_URL=
MEETING_REQUEST_TO=

# --- Infrastructure (phase 2+) -----------------------------------------------
# A relative file: URL is resolved against the repository root, not the working
# directory, so the CLI and the running system always open the same database.
DATABASE_URL=file:./data/anzsdr.db
REDIS_URL=redis://localhost:6379
