{
  "name": "anz-voice-sdr",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous multi-agent cold-calling SDR for Hexaware ANZ",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "holidays:build": "tsx scripts/holidays/build.ts",
    "holidays:verify": "tsx scripts/holidays/verify.ts",
    "kill": "tsx src/ops/kill-switch-cli.ts",
    "db:setup": "prisma migrate deploy && prisma generate",
    "db:studio": "prisma studio",
    "tick": "tsx src/orchestrator/cli.ts",
    "postinstall": "prisma generate",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "plan": "tsx src/orchestrator/plan-cli.ts",
    "serve": "tsx src/web/start.ts",
    "console:demo": "tsx src/stream/demo/start.ts",
    "apollo:check": "tsx scripts/apollo-check.ts",
    "prospect": "tsx scripts/prospect.ts",
    "scout": "tsx scripts/scout.ts",
    "enrich:worker": "tsx scripts/enrichment-worker.ts",
    "accounts:import": "tsx scripts/accounts.ts import",
    "accounts:export": "tsx scripts/accounts.ts export",
    "knowledge:status": "tsx scripts/knowledge.ts status",
    "knowledge:sync": "tsx scripts/knowledge.ts sync",
    "knowledge:approve": "tsx scripts/knowledge.ts approve",
    "knowledge:reject": "tsx scripts/knowledge.ts reject",
    "caller:smoke": "tsx scripts/caller-smoke.ts",
    "voice:serve": "tsx src/voice/start.ts",
    "voice:doctor": "tsx scripts/voice-doctor.ts",
    "voice:assistant": "tsx scripts/voice-assistant.ts",
    "voice:testcall": "tsx scripts/voice-testcall.ts",
    "voice:latency": "tsx scripts/voice-latency.ts",
    "voice:reprocess": "tsx scripts/voice-reprocess.ts",
    "recordings:purge": "tsx scripts/recordings-purge.ts",
    "concierge:preview": "tsx scripts/concierge.ts preview",
    "concierge:nudge": "tsx scripts/concierge.ts nudge",
    "concierge:reply": "tsx scripts/concierge.ts reply",
    "crm:sync": "tsx scripts/concierge.ts crm",
    "coach": "tsx src/agents/coach/cli.ts",
    "analyst:digest": "tsx src/agents/analyst/cli.ts",
    "test:coverage:gate": "vitest run tests/playbook --coverage --coverage.include=src/playbook/gate.ts --coverage.thresholds.100=true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.4",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.2",
    "luxon": "^3.5.0",
    "prisma": "^6.19.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
